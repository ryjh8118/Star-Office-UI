{
  "manifest_version": 3,
  "name": "RENGUIN Office · ChatGPT 工作連線",
  "version": "1.0.0",
  "description": "把 ChatGPT 回覆狀態與頁面標題送到本機 Star Office，不讀取對話文字。",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://chatgpt.com/*"], "js": ["chatgpt.js"] },
    { "matches": ["http://127.0.0.1/*"], "js": ["office.js"] }
  ]
}
